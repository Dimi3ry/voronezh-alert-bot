# === Настройки Telegram для бота оповещений (БПЛА, ракетная опасность, отбой) ===
# Можно задать отдельные секреты ALERT_TELEGRAM_* или переиспользовать TELEGRAM_*
ALERT_TELEGRAM_BOT_TOKEN=123456789:AABBccDDeeFFggHHiiJJkkLLmmNNooPPqq
ALERT_TELEGRAM_CHANNEL_ID=@voronezh_alerts_example

# === Гео-охват и фильтрация ===
# region — Воронеж и Воронежская область (включая сирены по отдельным районам с указанием района)
# city   — только Воронеж и общеобластные объявления (без сирен сугубо в других районах)
ALERT_GEO_SCOPE=region

# Не публиковать оповещения старше N минут (чтобы старые архивные посты не уходили как срочные)
ALERT_MAX_ITEM_AGE_MINUTES=120

# Окно подавления дублей одного и того же события (минуты)
ALERT_DEDUP_COOLDOWN_MINUTES=45
ALERT_MEDIA_FALLBACK_COOLDOWN_MINUTES=20
ALERT_STATE_TTL_HOURS=12

# Сколько самых свежих тревог опубликовать при самом первом запуске (0 — ничего не постить при старте)
ALERT_INITIAL_POST_LIMIT=1
ALERT_MAX_POSTS_PER_CYCLE=5
ALERT_POST_DELAY_SECONDS=1.5

# === Оформление и уведомления ===
ALERT_INCLUDE_SAFETY_MEMO=true
ALERT_INCLUDE_SOURCE=false
ALERT_INCLUDE_TIME=false
ALERT_DISABLE_NOTIFICATION=false
ALERT_DISABLE_CLEAR_NOTIFICATION=false
TIMEZONE=Europe/Moscow

# === Хранилище и сеть ===
ALERT_DB_PATH=data/alert_bot.db
ALERT_SOURCES_PATH=alert_sources.json
HTTP_TIMEOUT_SECONDS=15
PROXY_URL=
LOG_LEVEL=INFO
